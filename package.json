{
  "name": "activitywatch-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development PORT=15173 tsx watch server/dev.ts",
    "build": "npm run typecheck && vite build && tsup server/index.ts --format esm --platform node --out-dir dist-server --clean",
    "start": "cross-env NODE_ENV=production PORT=15173 node dist-server/index.js",
    "startup:install": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/startup.ps1 install",
    "startup:uninstall": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/startup.ps1 uninstall",
    "startup:status": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/startup.ps1 status",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.66.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "echarts": "^6.1.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "luxon": "^3.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.50.1",
    "@tailwindcss/vite": "^4.0.6",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/express": "^5.0.0",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "jsdom": "^26.0.0",
    "supertest": "^7.0.0",
    "tailwindcss": "^4.0.6",
    "tsup": "^8.3.6",
    "tsx": "^4.19.2",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
